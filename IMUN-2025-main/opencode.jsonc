{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "stitch": {
        "type": "remote",
        "url": "https://stitch.googleapis.com/mcp",
        "oauth": false,
        "headers": {
          "X-Goog-Api-Key": "{file:~/.config/opencode/stitch-api-key}"
        }
      }
    }
  }
}
